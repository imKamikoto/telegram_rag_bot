# ─── Telegram API (my.telegram.org → API development tools) ──────────────────
# Аккаунт 1 (основной тестовый)
TG_API_ID_1=
TG_API_HASH_1=
TG_PHONE_1=+7XXXXXXXXXX

# Аккаунт 2 (второй тестовый)
TG_API_ID_2=
TG_API_HASH_2=
TG_PHONE_2=+7XXXXXXXXXX

# Аккаунт 3 (опционально)
# TG_API_ID_3=
# TG_API_HASH_3=
# TG_PHONE_3=+7XXXXXXXXXX

# ─── Бот ─────────────────────────────────────────────────────────────────────
BOT_USERNAME=@your_bot_username

# ─── Инвайт-коды (многоразовые) ──────────────────────────────────────────────
# По одному коду на каждую KB — такие же как в locust/.env
INVITE_CODE_IT=
INVITE_CODE_HR=
INVITE_CODE_ADMIN=
INVITE_CODE_SALES=
INVITE_CODE_MARKETING=
INVITE_CODE_QA=
INVITE_CODE_LEGAL=
INVITE_CODE_SEC=
INVITE_CODE_FINANCE=

# ─── Параметры теста ─────────────────────────────────────────────────────────
# Сколько раз каждый аккаунт прогоняет сценарий
ITERATIONS=5

# Пауза между сообщениями (сек) — чтобы не получить flood wait
MESSAGE_DELAY=1.0

# Таймаут ожидания ответа от бота (сек)
RESPONSE_TIMEOUT=60
