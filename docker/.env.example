# ─── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_IDS=123456789,987654321    # comma-separated Telegram user IDs
ADMIN_WEBAPP_URL=https://your-domain.com  # public HTTPS URL for the admin mini app

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432
RAG_DATABASE_URL=postgresql+asyncpg://rag_user:change_me_in_production@postgres:5432/rag

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
RAG_REDIS_URL=redis://redis:6379/0

# ─── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RAG_MINIO_ENDPOINT=minio:9000
RAG_MINIO_ACCESS_KEY=minioadmin
RAG_MINIO_SECRET_KEY=change_me_in_production
RAG_MINIO_BUCKET=rag-documents
RAG_MINIO_SECURE=false

# ─── LLM / Embedding (external server, OpenAI-compatible API) ─────────────────
# Examples:
#   LiteLLM proxy:  http://your-server:4000/v1
#   Ollama direct:  http://your-server:11434/v1
#   vLLM:           http://your-server:8000/v1
RAG_LLM_BASE_URL=http://your-llm-server:4000/v1
RAG_LLM_API_KEY=ollama
RAG_LLM_MODEL=llama3
RAG_EMBED_BASE_URL=http://your-llm-server:11434/v1
RAG_EMBED_MODEL=nomic-embed-text
RAG_EMBED_DIM=768

# ─── RAG pipeline ──────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SEMANTIC_CACHE_THRESHOLD=0.92

# ─── RAG API server ────────────────────────────────────────────────────────────
RAG_API_URL=http://rag_app:8000/api/v1
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000

# ─── Admin WebApp ──────────────────────────────────────────────────────────────
WEBAPP_PORT=3000
